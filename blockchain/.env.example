# Copy this file to .env and fill in real values before deploying to a testnet.
# Never commit your real .env file.

# RPC endpoint for Ethereum Sepolia testnet - get a free one from
# https://www.infura.io or https://www.alchemy.com
SEPOLIA_RPC_URL=

# RPC endpoint for Polygon Amoy testnet (Mumbai is deprecated) - also
# available free from Infura/Alchemy.
AMOY_RPC_URL=

# Private key of the wallet that will pay gas and deploy the contract.
# Use a BURNER/TEST wallet only - never your main wallet's key, and
# never a wallet holding real funds.
PRIVATE_KEY=

# Optional - only needed if you want to verify the contract source on
# Etherscan / Polygonscan after deployment.
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=
