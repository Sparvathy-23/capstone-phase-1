# Copy to .env and fill in as you go. Everything has a working
# default so the backend runs with zero config for local dev - you
# only need to touch the blockchain settings once blockchain/ is
# deployed.

# --- Database ------------------------------------------------------
# SQLite needs no setup. Swap for Postgres later, e.g.:
# postgresql://postgres:password@localhost:5432/content_authenticity
DATABASE_URL=sqlite:///./content_authenticity.db

# --- Original photo storage -----------------------------------------
STORAGE_DIR=./storage_data

# --- Blockchain ------------------------------------------------------
# Leave BLOCKCHAIN_ENABLED=false until you've deployed blockchain/ and
# have real values for the three settings below.
BLOCKCHAIN_ENABLED=false

# Same RPC URL you used in blockchain/.env (SEPOLIA_RPC_URL or AMOY_RPC_URL)
WEB3_RPC_URL=

# Address printed after `npm run deploy:sepolia` (or :amoy)
CONTRACT_ADDRESS=

# Private key of a burner/test wallet used to pay gas for registerHash().
# NEVER use a wallet with real funds. This can be the same wallet as
# blockchain/.env's PRIVATE_KEY, or a different one - doesn't matter,
# as long as it holds testnet funds from a faucet.
BACKEND_WALLET_PRIVATE_KEY=

# --- Misc --------------------------------------------------------------
CORS_ALLOW_ORIGINS=*
